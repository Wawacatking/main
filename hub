-- Check group membership
local function checkGroupAccess()
    local isInGroup = false
    pcall(function()
        isInGroup = LocalPlayer:IsInGroup(GROUP_ID)
    end)

    if not isInGroup then
        statusLabel.Text = "Join the group to continue"
        statusLabel.TextColor3 = Color3.fromRGB(255, 120, 120)
        joinButton.Visible = true
    else
        statusLabel.Text = "Access Granted"
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 170)
        joinButton.Visible = false
    end
end

-- Button click handler
local isProcessing = false
joinButton.MouseButton1Click:Connect(function()
    if isProcessing then return end
    isProcessing = true

    local success = false

    if typeof(openbrowser) == "function" then
        openbrowser(GROUP_LINK)
        success = true
    elseif typeof(open_url) == "function" then
        open_url(GROUP_LINK)
        success = true
    end

    if success then
        statusLabel.Text = "Opened in browser (if not, paste in Chrome)"
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 170)
    else
        if typeof(setclipboard) == "function" then
            setclipboard(GROUP_LINK)
            statusLabel.Text = "Link copied! Paste it in Chrome"
            statusLabel.TextColor3 = Color3.fromRGB(0, 200, 255)
        else
            statusLabel.Text = "Copy link and open in Chrome"
        end
    end

    task.wait(1)
    isProcessing = false
end)

